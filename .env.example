# NosyAPI — Spor Toto bülteni (https://www.nosyapi.com)
# GitHub Actions: Repository Secrets → NOSYAPI_KEY
NOSYAPI_KEY=

# Alternatif: kendi JSON API uç noktanız
BULLETIN_API_URL=
LIVE_SCORES_API_URL=

# Frontend (Vite) — isteğe bağlı uzak bülten/canlı skor URL'leri
VITE_BULLETIN_REMOTE_URL=
VITE_LIVE_SCORES_REMOTE_URL=
